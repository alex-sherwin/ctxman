---
import EmptyState from '../../components/EmptyState.astro';
import FilterForm from '../../components/FilterForm.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getDataset } from '../../datasets/registry.ts';
import { filterEntries } from '../../lib/entry-filter.ts';
import { getRelationGraph, listEntries } from '../../lib/entries.ts';
import { rememberedSortHref, sortCookieName } from '../../lib/list-sort-memory.ts';
import { childrenOf } from '../../lib/relations.ts';
import { listSortHref, parseListParams } from '../../lib/url-state.ts';
import Base from '../../layouts/Base.astro';
import ListTable from '../../ui/list/ListTable.tsx';
import { LIST_DATA_ID, serializeListData } from '../../ui/list/list-data.ts';

const def = getDataset(Astro.params.dataset ?? '');
if (!def) return Astro.rewrite('/404');

// A list URL without `sort` and `dir` opens in the sort last chosen on this list (a cookie, list-sort-memory.ts).
const remembered = rememberedSortHref(
  Astro.url,
  def.id,
  Astro.cookies.get(sortCookieName(def.id))?.value,
);
if (remembered !== null) return Astro.redirect(remembered, 302);

// Unknown / not-applicable params are ignored by parseListParams (never an error).
const params = parseListParams(Astro.url.searchParams, def.id);
const everything = await listEntries(def.id);

// `?project=<slug>`: only the children of that project (its `child` relations; any dataset). The project is a scope,
// not a filter: the chip counts and "n of m" below are over its children of this dataset.
let all = everything;
let projectTitle: string | undefined;
if (params.project !== null) {
  const children = new Set(childrenOf(await getRelationGraph(), `project/${params.project}`));
  all = everything.filter((e) => children.has(`${e.dataset}/${e.slug}`));
  const project = (await listEntries('project')).find((e) => e.slug === params.project);
  if (project !== undefined) projectTitle = project.title ?? project.name;
}
const entries = filterEntries(all, {
  q: params.q,
  states: params.states,
  tags: params.tags,
  type: params.type,
  sort: params.sort,
  dir: params.dir,
});

// Every dataset has a create form at /new/<ds>; with a project filter active the new okf / skill entry is prefilled
// as a child of that project (`?parent=`).
const newHref =
  params.project !== null && def.kind !== 'data'
    ? `/new/${def.id}?parent=${params.project}`
    : `/new/${def.id}`;
// Clearing the filters keeps the sort (it is remembered anyway, see above).
const clearHref = listSortHref(`/${def.id}`, params.sort, params.dir);
---

<Base title={def.label} active={def.id} createHref={newHref}>
  <PageHeader title={def.label}>
    <a
      slot="actions"
      class="ck-button ck-button--secondary ck-button--sm"
      href={newHref}
      data-testid="list-new-entry"
    >
      <span class="ck-button__label">New {def.singular}</span>
    </a>
    <span slot="meta">{def.description}</span>
  </PageHeader>

  <FilterForm
    def={def}
    params={params}
    entries={all}
    shown={entries.length}
    projectTitle={projectTitle}
    clearHref={clearHref}
  />

  {
    entries.length > 0 ? (
      <>
        {/* The table is client-only: the page ships its rows as JSON, ListTable reads them when it mounts. */}
        <script
          is:inline
          type="application/json"
          id={LIST_DATA_ID}
          set:html={serializeListData({
            dataset: def.id,
            entries,
            sort: params.sort,
            dir: params.dir,
            now: Date.now(),
          })}
        />
        <ListTable client:only="react" />
      </>
    ) : (
      <EmptyState
        title={
          all.length > 0
            ? 'No entries match these filters'
            : params.project !== null
              ? `No ${def.plural} in this project yet`
              : `No ${def.plural} yet`
        }
      >
        {all.length > 0 ? <a href={clearHref}>Clear filters</a> : <a href={newHref}>Add the first one</a>}
      </EmptyState>
    )
  }
</Base>
