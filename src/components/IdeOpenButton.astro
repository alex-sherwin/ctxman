---
import type { DatasetId } from '../datasets/registry.ts';

// "Open in IDE" for one file of an entry (ROUND2_UI_SPEC §G.1). Vanilla: src/scripts/shell.ts handles the click on
// `[data-ide-open]` (POST /api/ide/open) and, on load, asks GET /api/ide/open whether an IDE command exists and
// disables the button when none does. The status element is the `[data-ide-status]` sibling inside this wrapper.
interface Props {
  dataset: DatasetId;
  slug: string;
  /** Bundle-relative path of the shown file: 'index.md', 'SKILL.md' or a sub-doc's relPath. */
  path: string;
}

const { dataset, slug, path } = Astro.props;
---

<div class="cx-detail__tools">
  <button
    type="button"
    class="ck-button ck-button--secondary ck-button--sm"
    data-ide-open
    data-dataset={dataset}
    data-slug={slug}
    data-path={path}
    data-testid="detail-open-ide"
  >
    <span class="ck-button__label">Open in IDE</span>
  </button>
  <span
    class="cx-detail__idestatus"
    data-ide-status
    role="status"
    aria-live="polite"
    data-testid="detail-ide-status"></span>
</div>
