---
import type { RecipeData } from '../datasets/schemas.ts';
import {
  DEFAULT_CONTEXT_FILE,
  ITEM_KINDS,
  ITEM_KIND_LABELS,
  MATERIAL_OPTION_IDS,
  OPTION_IDS,
  STUB_IDS,
  STUB_LABELS,
  stubDefaults,
} from '../lib/inflate/catalog.ts';
import type { RecipeContextRef, RecipeItemRef } from '../lib/entries.ts';
import { PREAMBLE_TARGET_ID, blockTargetId } from '../ui/markdown/targets.ts';
import DatasetBadge from './DatasetBadge.astro';
import EmptyState from './EmptyState.astro';
import MdEditButton from './MdEditButton.astro';
import Panel from './Panel.astro';

// View of a recipe's composition (detail page main column). Editing happens in /inflate, except the preamble
// and the markdown blocks, which have a pencil button (`data-md-edit`) each: the MarkdownTargets island,
// mounted ONCE by the page with `recipeTargets(slug, blocks)` from src/ui/markdown/targets.ts, enables them.
interface Props {
  slug: string;
  data: RecipeData;
  contexts: RecipeContextRef[];
  items: RecipeItemRef[];
  /** `preamble` rendered with the project's markdown pipeline. */
  preambleHtml?: string | undefined;
  blocks: { id: string; html: string }[];
}

const { slug, data, contexts, items, preambleHtml, blocks } = Astro.props;

// Options in catalog order, `k=v` joined by ', '.
const optionText = (options: Record<string, unknown> | undefined): string =>
  OPTION_IDS.filter((id) => options?.[id] !== undefined)
    .map((id) => `${id}=${String(options?.[id])}`)
    .join(', ');

// Material options (clone depth, branch, subpath only) in catalog order, `k=v` joined by ', '.
const materialOptionText = (options: Record<string, unknown> | undefined): string =>
  MATERIAL_OPTION_IDS.filter((id) => options?.[id] !== undefined)
    .map((id) => `${id}=${String(options?.[id])}`)
    .join(', ');

const defaults = ITEM_KINDS.flatMap((kind) => {
  const d = data.defaults[kind];
  const material = d?.material;
  return d === undefined ||
    (d.mode === undefined && optionText(d.options) === '' && material === undefined)
    ? []
    : [
        {
          kind,
          mode: d.mode,
          options: optionText(d.options),
          material,
          materialOptions: materialOptionText(d.materialOptions),
        },
      ];
});

// The working directory a run writes to (`output`), with the generated files it will write.
const output = data.output;
const stubDefaultsFor = stubDefaults(data.target);
const stubs = STUB_IDS.filter((id) => output?.stubs?.[id] ?? stubDefaultsFor[id]).map(
  (id) => STUB_LABELS[id],
);
---

<section class="cx-recipe" aria-label="Composition" data-testid="recipe-composition" data-slug={slug}>
  <Panel title="Contexts" count={contexts.length} id="h-rc-contexts" testid="recipe-contexts">
    {
      contexts.length > 0 ? (
        <ul class="cx-minilist">
          {contexts.map((c) => (
            <li
              class:list={['cx-minilist__row', !c.missing && 'cx-rowlink']}
              data-testid="recipe-context"
              data-slug={c.slug}
              data-missing={c.missing ? 'true' : undefined}
            >
              {c.missing ? (
                <span class="ck-entryline__title ck-entryline__title--missing">{c.slug}</span>
              ) : (
                <a class="ck-entryline__title cx-rowlink__main" href={c.url}>
                  {c.slug}
                </a>
              )}
              <span class="cx-subtle cx-truncate" title={c.description}>
                {c.description}
              </span>
              <span class="cx-mono cx-subtle">
                {c.linkCount !== undefined ? `${c.linkCount} links` : ''}
              </span>
              <span>{c.missing && <span class="ck-badge ck-badge--danger">missing</span>}</span>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState compact title="None" />
      )
    }
  </Panel>

  <Panel title="Ad hoc items" count={items.length} id="h-rc-items" testid="recipe-items">
    {
      items.length > 0 ? (
        <ul class="cx-minilist">
          {items.map((i) => (
            <li
              class:list={['cx-minilist__row', !i.missing && 'cx-rowlink']}
              data-testid="recipe-item"
              data-key={i.key}
              data-missing={i.missing ? 'true' : undefined}
            >
              <DatasetBadge dataset={i.dataset} />
              {i.missing ? (
                <span class="ck-entryline__title ck-entryline__title--missing">{i.title ?? i.slug}</span>
              ) : (
                <a class="ck-entryline__title cx-rowlink__main cx-truncate" href={i.url}>
                  {i.title ?? i.slug}
                </a>
              )}
              {i.title !== undefined && i.title !== i.slug ? (
                <code class="cx-subtle">{i.slug}</code>
              ) : (
                <span />
              )}
              <span>{i.missing && <span class="ck-badge ck-badge--danger">missing</span>}</span>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState compact title="None" />
      )
    }
  </Panel>

  {
    output !== undefined && (
      <Panel title="Output" id="h-rc-output" testid="recipe-output">
        <table class="ck-table ck-table--compact">
          <tbody class="ck-table__body">
            <tr class="ck-table__row">
              <th class="ck-table__th" scope="row">
                Directory
              </th>
              <td class="ck-table__td cx-mono" data-testid="recipe-output-dir">
                {output.dir ?? 'document only'}
              </td>
            </tr>
            <tr class="ck-table__row">
              <th class="ck-table__th" scope="row">
                Context file
              </th>
              <td class="ck-table__td cx-mono">{output.contextFile ?? DEFAULT_CONTEXT_FILE}</td>
            </tr>
            <tr class="ck-table__row">
              <th class="ck-table__th" scope="row">
                Primary
              </th>
              <td class="ck-table__td" data-testid="recipe-output-primary">
                {output.primary !== undefined ? (
                  <a href={`/${output.primary}`}>
                    <code>{output.primary}</code>
                  </a>
                ) : (
                  <span class="cx-subtle">none</span>
                )}
              </td>
            </tr>
            <tr class="ck-table__row">
              <th class="ck-table__th" scope="row">
                Generated files
              </th>
              <td class="ck-table__td">{stubs.length > 0 ? stubs.join(', ') : 'none'}</td>
            </tr>
            {output.allowNonEmpty === true && (
              <tr class="ck-table__row">
                <th class="ck-table__th" scope="row">
                  Non-empty directory
                </th>
                <td class="ck-table__td">allowed</td>
              </tr>
            )}
          </tbody>
        </table>
      </Panel>
    )
  }

  <Panel title="Preamble" id="h-rc-preamble" testid="recipe-preamble">
    <Fragment slot="actions">
      <MdEditButton
        id={PREAMBLE_TARGET_ID}
        label="preamble"
        testid="recipe-edit-preamble"
      />
    </Fragment>
    {
      preambleHtml !== undefined ? (
        <div class="cx-recipe__body cx-prose cx-prose--compact" set:html={preambleHtml} />
      ) : (
        <EmptyState compact title="None" />
      )
    }
  </Panel>

  <Panel title="Markdown blocks" count={blocks.length} id="h-rc-blocks" testid="recipe-blocks">
    {
      blocks.length > 0 ? (
        blocks.map((b) => (
          <div class="cx-recipe__block" data-testid="recipe-block" data-id={b.id}>
            <details class="cx-recipe__details">
              <summary>
                <code>{b.id}</code>
              </summary>
              <div class="cx-recipe__body cx-prose cx-prose--compact" set:html={b.html} />
            </details>
            <MdEditButton
              class="cx-recipe__blockedit"
              id={blockTargetId(b.id)}
              label={`markdown block ${b.id}`}
              testid="recipe-block-edit"
            />
          </div>
        ))
      ) : (
        <EmptyState compact title="None" />
      )
    }
  </Panel>

  <Panel title="Overrides" count={data.overrides.length} id="h-rc-overrides" testid="recipe-overrides">
    {
      data.overrides.length > 0 ? (
        <table class="ck-table ck-table--compact">
          <thead class="ck-table__head">
            <tr>
              <th class="ck-table__th" scope="col">
                Item
              </th>
              <th class="ck-table__th" scope="col">
                Mode
              </th>
              <th class="ck-table__th" scope="col">
                Options
              </th>
              <th class="ck-table__th" scope="col">
                Material
              </th>
              <th class="ck-table__th" scope="col">
                Excluded
              </th>
            </tr>
          </thead>
          <tbody class="ck-table__body">
            {data.overrides.map((o) => (
              <tr class="ck-table__row" data-testid="recipe-override" data-key={o.key}>
                <td class="ck-table__td">
                  <code>{o.key}</code>
                </td>
                <td class="ck-table__td cx-mono">{o.mode ?? ''}</td>
                <td class="ck-table__td cx-mono">{optionText(o.options)}</td>
                <td class="ck-table__td cx-mono" data-testid="recipe-override-material">
                  {o.material ?? ''}
                  {materialOptionText(o.materialOptions) !== '' && (
                    <span class="cx-subtle"> {materialOptionText(o.materialOptions)}</span>
                  )}
                  {output?.primary === o.key && (
                    <span class="ck-badge ck-badge--info" data-testid="recipe-override-primary">
                      primary
                    </span>
                  )}
                </td>
                <td class="ck-table__td">
                  {o.exclude === true && <span class="ck-badge ck-badge--muted">excluded</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <EmptyState compact title="None" />
      )
    }
  </Panel>

  {
    defaults.length > 0 && (
      <Panel title="Default modes" count={defaults.length} id="h-rc-defaults" testid="recipe-defaults">
        <table class="ck-table ck-table--compact">
          <thead class="ck-table__head">
            <tr>
              <th class="ck-table__th" scope="col">
                Kind
              </th>
              <th class="ck-table__th" scope="col">
                Mode
              </th>
              <th class="ck-table__th" scope="col">
                Options
              </th>
              <th class="ck-table__th" scope="col">
                Material
              </th>
            </tr>
          </thead>
          <tbody class="ck-table__body">
            {defaults.map((d) => (
              <tr class="ck-table__row" data-testid="recipe-default" data-kind={d.kind}>
                <td class="ck-table__td">{ITEM_KIND_LABELS[d.kind]}</td>
                <td class="ck-table__td cx-mono">{d.mode ?? ''}</td>
                <td class="ck-table__td cx-mono">{d.options}</td>
                <td class="ck-table__td cx-mono">
                  {d.material ?? ''}
                  {d.materialOptions !== '' && <span class="cx-subtle"> {d.materialOptions}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </Panel>
    )
  }

  {
    data.order.length > 0 && (
      <Panel title="Custom order" count={data.order.length} id="h-rc-order" testid="recipe-order">
        <ol class="cx-recipe__order">
          {data.order.map((key) => (
            <li>
              <code>{key}</code>
            </li>
          ))}
        </ol>
      </Panel>
    )
  }
</section>
