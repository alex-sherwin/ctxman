---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="cx-pagehead">
  {
    Astro.slots.has('eyebrow') && (
      <div class="cx-pagehead__eyebrow">
        <slot name="eyebrow" />
      </div>
    )
  }
  <div class="cx-pagehead__row">
    <h1 class="cx-pagehead__title">{title}</h1>
    <div class="cx-pagehead__actions"><slot name="actions" /></div>
  </div>
  {
    Astro.slots.has('meta') && (
      <div class="cx-pagehead__meta cx-row">
        <slot name="meta" />
      </div>
    )
  }
</header>
