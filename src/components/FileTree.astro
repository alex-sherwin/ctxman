---
import { docUrl, entryUrl, fileUrl, OKF_ENTRY_FILE } from '../datasets/registry.ts';
import type { OkfDatasetId } from '../datasets/registry.ts';
import type { BundleFile } from '../lib/bundles.ts';
import { ancestorDirs, buildFileTree } from '../lib/file-tree.ts';
import FileTreeNodes from './FileTreeNodes.astro';
import type { FileTreeItem } from './FileTreeNodes.astro';
import Panel from './Panel.astro';

// The Files panel of okf + skill pages: the bundle as a folder tree (FileTreeNodes.astro). Folders start closed,
// except the ones that contain the file being shown, so the current file stays in view.
interface Props {
  dataset: OkfDatasetId | 'skill';
  slug: string;
  /** Files in tree order (src/lib/bundles.ts#listBundleFiles). */
  files: BundleFile[];
  /** Bundle-relative path of the file being shown, e.g. 'index.md' or 'concepts/search.md'. */
  current: string;
  /**
   * okf only: `+ Add file`, `+ Session` and `+ Plan` in the panel title (EntryTools island: `data-entry-action`
   * `add-file`, `import-session`, `import-plan`; rendered disabled until the island mounts).
   */
  canCreate?: boolean;
}

// The panel-title buttons of `canCreate`, in this order (small ghost buttons: they fit one line of the details column).
const CREATE_BUTTONS = [
  { action: 'add-file', testId: 'files-add-file', label: '+ Add file', title: undefined },
  {
    action: 'import-session',
    testId: 'files-import-session',
    label: '+ Session',
    title: 'Import an agent session',
  },
  { action: 'import-plan', testId: 'files-import-plan', label: '+ Plan', title: 'Import an agent plan' },
] as const;

const { dataset, slug, files, current, canCreate = false } = Astro.props;

const HINTS: Record<NonNullable<BundleFile['role']>, string> = {
  entry: 'entry',
  log: 'log',
};

// okf markdown files link to their route (the root index.md = the entry page), every non-markdown file to its raw
// bytes (`/<ds>/<slug>/file/<path>`, opened in a new tab). Skill markdown files have no route: plain text.
function hrefOf(file: BundleFile): string | undefined {
  if (file.kind !== 'markdown') return fileUrl(dataset, slug, file.path);
  if (dataset === 'skill') return undefined;
  return file.path === OKF_ENTRY_FILE ? entryUrl(dataset, slug) : docUrl(dataset, slug, file.path);
}

const items: FileTreeItem[] = files.map((file) => ({
  path: file.path,
  file,
  href: hrefOf(file),
  raw: file.kind !== 'markdown',
  hint: file.role ? HINTS[file.role] : undefined,
  current: file.path === current,
}));
const tree = buildFileTree(items);
---

<Panel as="nav" title="Files" id="h-files" testid="detail-files">
  {
    canCreate &&
      CREATE_BUTTONS.map((b) => (
        <button
          slot="actions"
          type="button"
          class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
          disabled
          title={b.title}
          data-entry-action={b.action}
          data-testid={b.testId}
        >
          <span class="ck-button__label">{b.label}</span>
        </button>
      ))
  }
  <div class="cx-files">
    <FileTreeNodes nodes={tree} open={ancestorDirs(current)} />
  </div>
</Panel>
