---
import { docUrl, entryUrl, OKF_ENTRY_FILE } from '../datasets/registry.ts';
import type { OkfDatasetId } from '../datasets/registry.ts';
import type { BundleFile } from '../lib/bundles.ts';
import Panel from './Panel.astro';

interface Props {
  dataset: OkfDatasetId | 'skill';
  slug: string;
  /** Files in tree order (src/lib/bundles.ts#listBundleFiles). */
  files: BundleFile[];
  /** Bundle-relative path of the file being shown, e.g. 'index.md' or 'concepts/search.md'. */
  current: string;
  /** okf only: a `+ New concept` button in the panel title (EntryTools island, `data-entry-action="new-concept"`). */
  canCreate?: boolean;
}

const { dataset, slug, files, current, canCreate = false } = Astro.props;

const HINTS: Record<NonNullable<BundleFile['role']>, string> = {
  entry: 'entry',
  log: 'log',
};

// okf markdown files link to their route (the root index.md = the entry page). Skill files and non-markdown
// files have no route, so they are listed as plain text.
function hrefOf(file: BundleFile): string | undefined {
  if (dataset === 'skill' || file.kind !== 'markdown') return undefined;
  return file.path === OKF_ENTRY_FILE ? entryUrl(dataset, slug) : docUrl(dataset, slug, file.path);
}

const items = files.map((file) => {
  const cut = file.path.lastIndexOf('/');
  return {
    file,
    href: hrefOf(file),
    dir: cut === -1 ? '' : file.path.slice(0, cut + 1),
    base: cut === -1 ? file.path : file.path.slice(cut + 1),
    hint: file.role ? HINTS[file.role] : undefined,
    current: file.path === current,
  };
});
---

<Panel as="nav" title="Files" id="h-files" testid="detail-files">
  {
    canCreate && (
      <button
        slot="actions"
        type="button"
        class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
        disabled
        data-entry-action="new-concept"
        data-testid="files-new-concept"
      >
        <span class="ck-button__label">+ New concept</span>
      </button>
    )
  }
  <ul class="cx-files__list" role="list">
    {
      items.map((item) => (
        <li>
          {item.href ? (
            <a
              class="cx-files__item"
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
            >
              {item.dir && <span class="cx-files__dir">{item.dir}</span>}
              {item.base}
            </a>
          ) : (
            <span class="cx-files__item" aria-current={item.current ? 'page' : undefined}>
              {item.dir && <span class="cx-files__dir">{item.dir}</span>}
              {item.base}
            </span>
          )}
          {item.hint && <span class="cx-files__hint">{item.hint}</span>}
        </li>
      ))
    }
  </ul>
</Panel>
