---
import { datasetDef, isTimeTrackedDatasetId } from '../datasets/registry.ts';
import type { DatasetId, OkfDatasetId } from '../datasets/registry.ts';
import type { EntryDetail } from '../lib/entries.ts';
import BackRefs from './BackRefs.astro';
import FileTree from './FileTree.astro';
import IdeOpenButton from './IdeOpenButton.astro';
import MetaPanel from './MetaPanel.astro';
import RelationPanels from './RelationPanels.astro';

// The details column of an entry page (`/<ds>/<slug>`): Open in IDE (okf, skill, snippet), the metadata panel (with
// the Details `Edit` button for okf + skill), the file tree (okf + skill, with `+ Add file` for okf; ABOVE the
// metadata panel so switching files never moves the list), the relation
// panels (Links to / Linked from; reference and snippet: Linked from only) and the "Linked from contexts" list (not
// for context / recipe). It sits LEFT of the content on okf + skill pages (`cx-detail--doc`) and RIGHT of it on
// reference / snippet / context / recipe pages. A project lists its `child` links in the Children panel (main column), so
// "Links to" leaves them out.
interface Props {
  dataset: DatasetId;
  slug: string;
  detail: EntryDetail;
}

const { dataset, slug, detail } = Astro.props;
const entryFile = datasetDef(dataset).entryFile;
const relations = 'relations' in detail ? detail.relations : undefined;
const linksTo =
  relations === undefined
    ? []
    : dataset === 'project'
      ? relations.linksTo.filter((row) => row.rel !== 'child')
      : relations.linksTo;
---

<aside class="cx-detail__aside" aria-label="Entry details" data-testid="detail-aside">
  {
    (detail.kind === 'okf' || detail.kind === 'skill') && (
      <IdeOpenButton
        dataset={dataset}
        slug={slug}
        path={entryFile}
      />
    )
  }
  {detail.kind === 'snippet' && <IdeOpenButton dataset={dataset} slug={slug} />}
  {
    (detail.kind === 'okf' || detail.kind === 'skill') && (
      <FileTree
        dataset={dataset as OkfDatasetId | 'skill'}
        slug={slug}
        files={detail.files}
        current={entryFile}
        canCreate={detail.kind === 'okf'}
      />
    )
  }
  <MetaPanel
    dataset={dataset}
    kind={detail.kind}
    data={detail.data}
    lastModified={detail.summary.lastModified}
    file={detail.fileRelPath}
    editable={detail.kind === 'okf' || detail.kind === 'skill'}
    logTime={detail.kind === 'okf' && isTimeTrackedDatasetId(dataset)}
  />
  {
    relations && (
      <RelationPanels
        dataset={dataset}
        linksTo={linksTo}
        linkedFrom={relations.linkedFrom}
        canEdit={detail.kind === 'okf'}
        showLinksTo={detail.kind !== 'reference' && detail.kind !== 'snippet'}
      />
    )
  }
  {dataset !== 'context' && dataset !== 'recipe' && <BackRefs dataset={dataset} slug={slug} refs={detail.backRefs} />}
</aside>
