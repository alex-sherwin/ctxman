---
import { OWNER_LABELS, REFERENCE_TYPE_LABELS } from '../datasets/registry.ts';
import { isLocalReference } from '../datasets/schemas.ts';
import type { ReferenceData } from '../datasets/schemas.ts';
import { classifyRemoteUri } from '../lib/remote-uri.ts';
import { INFO_TARGET_ID } from '../ui/markdown/targets.ts';
import CopyButton from './CopyButton.astro';
import EmptyState from './EmptyState.astro';
import MdEditButton from './MdEditButton.astro';
import Panel from './Panel.astro';

// A reference's fields are the content (main column of the detail page), plus the optional `info` markdown in
// its own panel. Its pencil button is enabled by the MarkdownTargets island, which the PAGE mounts.
interface Props {
  data: ReferenceData;
  /** `info` rendered with the project's markdown pipeline. */
  infoHtml?: string | undefined;
}

const { data, infoHtml } = Astro.props;

const where = isLocalReference(data)
  ? { label: 'Path', value: data.path }
  : { label: 'URI', value: data.uri };
const subpath = data.subpath ?? '';
const uriKind = data.type === 'remote-skill' ? classifyRemoteUri(data.uri) : null;
const isUrl = /^https?:\/\//i.test(where.value);
const root = uriKind === 'archive' ? 'archive root' : data.type === 'local-folder' ? 'folder root' : 'repo root';
// Inflate places a repository at repos/<folder> and a folder at folders/<folder> (a remote skill has no folder)
const folder = data.type === 'remote-skill' ? undefined : (data.folder ?? null);
const placeUnder = data.type === 'local-folder' ? 'folders/' : 'repos/';
---

<dl class="cx-fields" data-testid="reference-fields">
  <dt class="ck-label">Type</dt>
  <dd>
    <span class="ck-badge ck-badge--muted ck-badge--mono">{data.type}</span>
    {" "}
    {
      uriKind && (
        <>
          <span class="ck-badge ck-badge--info ck-badge--mono" data-testid="uri-kind-badge">{uriKind}</span>
          {" "}
        </>
      )
    }
    <span class="cx-subtle">{REFERENCE_TYPE_LABELS[data.type]}</span>
  </dd>
  <dt class="ck-label">{where.label}</dt>
  <dd>
    {
      isUrl ? (
        <a class="cx-mono" href={where.value} target="_blank" rel="noreferrer">
          {where.value} ↗
        </a>
      ) : (
        <code class="cx-mono">{where.value}</code>
      )
    }
    {" "}
    <CopyButton text={where.value} ariaLabel={`Copy ${where.label.toLowerCase()}`} />
  </dd>
  <dt class="ck-label">Subpath</dt>
  <dd>{subpath ? <code class="cx-mono">{subpath}</code> : <span class="cx-subtle">{root}</span>}</dd>
  {
    folder !== undefined && (
      <>
        <dt class="ck-label">Folder name</dt>
        <dd data-testid="reference-folder">
          {folder !== null ? (
            <code class="cx-mono">{folder}</code>
          ) : (
            <span class="cx-subtle">{data.name} (the reference name)</span>
          )}{" "}
          <span class="cx-subtle">in an Inflate working directory: {placeUnder}{folder ?? data.name}</span>
        </dd>
      </>
    )
  }
  <dt class="ck-label">Owner</dt>
  <dd>{OWNER_LABELS[data.owner]}</dd>
</dl>

<Panel title="Info" id="h-ref-info" testid="reference-info">
  <Fragment slot="actions">
    <MdEditButton id={INFO_TARGET_ID} label="info" testid="reference-edit-info" />
  </Fragment>
  {
    infoHtml !== undefined ? (
      <div class="cx-refinfo__body cx-prose" set:html={infoHtml} />
    ) : (
      <EmptyState compact title="None" />
    )
  }
</Panel>
