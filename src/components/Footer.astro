---
import pkg from '../../package.json';
import { resolveDataDir } from '../lib/data-dir.ts';
import CopyButton from './CopyButton.astro';

const dataDir = resolveDataDir();
---

<footer class="cx-footer" data-testid="app-footer">
  <span class="cx-label">data</span>
  <code class="cx-mono" data-testid="footer-data-dir">{dataDir}</code>
  <CopyButton text={dataDir} ariaLabel="Copy data directory path" />
  <span class="cx-footer__spacer"></span>
  <span class="cx-mono">ctxman v{pkg.version}</span>
</footer>
