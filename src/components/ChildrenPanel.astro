---
import { datasetDef, entryUrl, LINKABLE_DATASETS, stateGroup } from '../datasets/registry.ts';
import type { RelationRow } from '../lib/entries.ts';
import DatasetBadge from './DatasetBadge.astro';
import StateBadge from './StateBadge.astro';

// Project pages: the children (frontmatter `links` with `rel: child`) in file order, with progress, Add existing,
// Build context, New links (`/new/<ds>?parent=<slug>`) and View links (`/<ds>?project=<slug>`). The project owns
// the child set (ROUND3_SPEC A1). Buttons carry `data-entry-action` and start disabled (EntryTools enables them).
interface Props {
  slug: string;
  children: readonly RelationRow[];
}

const { slug, children } = Astro.props;
const NEW_DATASETS = ['task', 'feature', 'idea', 'bug'] as const;

// One View link per dataset present among the children, registry order.
const views = LINKABLE_DATASETS.map((dataset) => ({
  dataset,
  count: children.filter((row) => row.dataset === dataset).length,
})).filter((view) => view.count > 0);

// "N of M done": M = children with a lifecycle state, N = those in the `done` group.
const withState = children.filter((row) => row.state !== undefined && !row.missing);
const done = withState.filter((row) => stateGroup(row.dataset, row.state ?? '') === 'done').length;
---

<section class="cx-panel cx-children" aria-labelledby="h-children" data-testid="children-panel">
  <h2 class="cx-panel__title" id="h-children">
    Children <span class="cx-panel__count" data-testid="children-count">{children.length}</span>
    {
      withState.length > 0 && (
        <span class="cx-children__progress" data-testid="children-progress">
          {done} of {withState.length} done
        </span>
      )
    }
    <span class="cx-panel__actions">
      <button
        type="button"
        class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
        disabled
        data-entry-action="add-child"
        data-testid="children-add"
      >
        <span class="ck-button__label">+ Add existing</span>
      </button>
      <button
        type="button"
        class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
        disabled
        data-entry-action="build-context"
        data-testid="entry-build-context"
      >
        <span class="ck-button__label">Build context</span>
      </button>
    </span>
  </h2>
  {
    children.length > 0 ? (
      <ul class="cx-minilist">
        {children.map((row) => (
          <li
            class="cx-minilist__row cx-rowlink cx-children__row"
            data-testid="children-row"
            data-key={row.key}
            data-missing={row.missing ? '' : undefined}
          >
            <DatasetBadge dataset={row.dataset} />
            {row.missing ? (
              <span class="cx-minilist__title cx-truncate" title={row.key}>
                {row.title}
              </span>
            ) : (
              <a
                class="cx-minilist__title cx-rowlink__main cx-truncate"
                href={entryUrl(row.dataset, row.slug)}
              >
                {row.title}
              </a>
            )}
            <span class="cx-row">
              {row.state !== undefined && <StateBadge dataset={row.dataset} state={row.state} />}
              {row.missing && <span class="ck-badge ck-badge--danger">missing</span>}
            </span>
            <button
              type="button"
              class="ck-button ck-button--ghost ck-button--sm ck-button--icon"
              disabled
              data-entry-action="remove-child"
              data-key={row.key}
              data-title={row.title}
              aria-label={`Remove ${row.title} from the children`}
              data-testid="children-remove"
            >
              <span class="ck-button__label" aria-hidden="true">×</span>
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="cx-relrow__empty">No children yet. Use <strong>+ Add existing</strong> or one of the New links below.</p>
    )
  }
  <div class="cx-children__foot">
    <span class="cx-children__group">
      <span class="cx-label">New</span>
      {
        NEW_DATASETS.map((ds) => (
          <a
            class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
            href={`/new/${ds}?parent=${slug}`}
            data-testid={`children-new-${ds}`}
          >
            <span class="ck-button__label">{ds}</span>
          </a>
        ))
      }
    </span>
    {
      views.length > 0 && (
        <span class="cx-children__group">
          <span class="cx-label">View</span>
          {views.map(({ dataset, count }) => (
            <a
              class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
              href={`/${dataset}?project=${slug}`}
              aria-label={`View ${datasetDef(dataset).plural} of this project`}
              data-testid={`children-view-${dataset}`}
            >
              <span class="ck-button__label">{dataset}</span>
              <span class="cx-children__count">{count}</span>
            </a>
          ))}
        </span>
      )
    }
  </div>
</section>
