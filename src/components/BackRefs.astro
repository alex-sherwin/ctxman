---
import { isLinkableDatasetId } from '../datasets/registry.ts';
import type { DatasetId } from '../datasets/registry.ts';
import type { BackRef } from '../lib/entries.ts';
import { withParams } from '../lib/url-state.ts';
import EmptyState from './EmptyState.astro';
import Panel from './Panel.astro';

// "Linked from contexts": every context whose links point at this entry (all datasets except context).
interface Props {
  dataset: DatasetId;
  slug: string;
  refs: BackRef[];
}

const { dataset, slug, refs } = Astro.props;

const NOTES_PREVIEW = 120;
const preview = (notes: string): string => {
  const flat = notes.replace(/\s+/g, ' ').trim();
  return flat.length > NOTES_PREVIEW ? `${flat.slice(0, NOTES_PREVIEW).trimEnd()}…` : flat;
};
---

<Panel title="Linked from contexts" id="h-backrefs" testid="detail-backrefs" count={refs.length}>
  {
    refs.length > 0 ? (
      <ul>
        {refs.map((ref) => (
          <li class="cx-minilist__row cx-backref cx-rowlink">
            <a class="ck-entryline__title cx-rowlink__main cx-backref__title" href={`/context/${ref.context}`}>
              {ref.context}
            </a>
            <a
              class="ck-button ck-button--ghost ck-button--sm ck-button--glow"
              href={`/forge?context=${ref.context}`}
              aria-label={`Open ${ref.context} in Forge`}
            >
              <span class="ck-button__label">Forge</span>
            </a>
            {ref.notes && <span class="cx-backref__notes cx-subtle cx-clamp-2">{preview(ref.notes)}</span>}
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState compact title="Not linked from any context">
        {isLinkableDatasetId(dataset) && (
          <a href={withParams('/forge', { dataset, q: slug })}>Find in Forge</a>
        )}
      </EmptyState>
    )
  }
</Panel>
