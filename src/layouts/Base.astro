---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { DatasetId } from '../datasets/registry.ts';
import { SearchWidget } from '../ui/search/SearchWidget.tsx';
import { Shortcuts } from '../ui/shortcuts/Shortcuts.tsx';

interface Props {
  title: string;
  /** Full-height app pages (/forge, /inflate): the page itself scrolls inside `main`, not the window. */
  fill?: boolean;
  /** Which header link to mark as the current section. */
  active?: DatasetId | 'forge' | 'inflate' | 'tools' | 'home';
  /** Where the `c` shortcut goes (the create form for this page's context); omit = no `c` shortcut. */
  createHref?: string;
  /** The page has a + Link button (`relation-add`): the `l` shortcut clicks it. */
  linkShortcut?: boolean;
  /** The page has an edit mode (DocEditor, or an Edit link to `?edit=1`): the `e` shortcut enters it. */
  editShortcut?: boolean;
}

const {
  title,
  fill = false,
  active,
  createHref,
  linkShortcut = false,
  editShortcut = false,
} = Astro.props;

const favicon = `data:image/svg+xml,${encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" fill="#0d0e14"/><text x="16" y="22" text-anchor="middle" font-family="monospace" font-size="16" font-weight="700" fill="#00f0ff">cx</text></svg>',
)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title} · ctxman</title>
    <link rel="icon" href={favicon} />
  </head>
  <body
    class={fill ? 'cx-shell--fill' : undefined}
    data-shortcut-create={createHref}
    data-shortcut-link={linkShortcut ? '' : undefined}
    data-shortcut-edit={editShortcut ? '' : undefined}
  >
    <a class="cx-skip ck-sr-only" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main" class="cx-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchWidget client:only="react" />
    <Shortcuts client:only="react" />
    <script>
      import '../scripts/shell.ts';
    </script>
  </body>
</html>
