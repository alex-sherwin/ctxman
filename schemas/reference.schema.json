{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ctxman.local/schemas/reference.schema.json",
  "title": "ctxman reference",
  "description": "reference/<name>.yaml: a pointer to a local repo, local folder, remote repo or remote skill.",
  "$comment": "Generated by scripts/gen-schemas.ts from src/datasets/schemas.ts; do not edit. Not expressible here (checked by pnpm run check): name must equal the file name; uri must be a real git URI (remote-skill: or an https .tar.gz/.tgz/.zip archive), the pattern is a lenient hint.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "must not be blank",
          "pattern": "\\S",
          "patternErrorMessage": "must not be blank"
        },
        "name": {
          "type": "string",
          "description": "must be kebab-case: a-z, 0-9, single hyphens, no leading/trailing hyphen (max 64 characters)",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64,
          "patternErrorMessage": "must be kebab-case: a-z, 0-9, single hyphens, no leading/trailing hyphen (max 64 characters)"
        },
        "owner": {
          "enum": [
            "me",
            "not-me"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "local-folder"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "info": {
          "type": "string"
        },
        "subpath": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "name",
        "owner",
        "path",
        "type"
      ],
      "additionalProperties": false
    },
