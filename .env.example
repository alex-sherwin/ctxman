# Required: the directory that holds your ctxman data (kb/, task/, reference/, context/ ...)
CTXMAN_DATA_DIR=/absolute/path/to/your/ctxman-data
# Optional: the origin written into YAML schema modelines (default http://127.0.0.1:4321)
# CTXMAN_SERVER_ORIGIN=http://127.0.0.1:4321
# Optional: the home directory the agent history import reads (~/.claude, ~/.codex, ~/.copilot, VS Code) instead of
# yours; when set, CLAUDE_CONFIG_DIR / CODEX_HOME / XDG_CONFIG_HOME / APPDATA are ignored (tests point it at a fake home)
# CTXMAN_AGENT_HOME=/absolute/path/to/a/home
