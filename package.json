{
  "name": "ctxman",
  "version": "0.1.0",
  "private": true,
  "description": "ctxman — local context manager for agentic AI coding: OKF knowledge bundles, ideas, tasks, bugs, features, projects, skills, references and reusable context pointers.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview",
    "astro": "astro",
    "sync": "astro sync",
    "add:kb": "node --env-file-if-exists=.env scripts/add-entry.ts kb",
    "add:rca": "node --env-file-if-exists=.env scripts/add-entry.ts rca",
    "add:idea": "node --env-file-if-exists=.env scripts/add-entry.ts idea",
    "add:task": "node --env-file-if-exists=.env scripts/add-entry.ts task",
    "add:bug": "node --env-file-if-exists=.env scripts/add-entry.ts bug",
    "add:feature": "node --env-file-if-exists=.env scripts/add-entry.ts feature",
    "add:project": "node --env-file-if-exists=.env scripts/add-entry.ts project",
    "add:skill": "node --env-file-if-exists=.env scripts/add-entry.ts skill",
    "add:reference": "node --env-file-if-exists=.env scripts/add-entry.ts reference",
    "add:context": "node --env-file-if-exists=.env scripts/add-entry.ts context",
    "add:recipe": "node --env-file-if-exists=.env scripts/add-entry.ts recipe",
    "check": "node --env-file-if-exists=.env scripts/check-all.ts && node scripts/check-schemas.ts",
    "check:data": "node --env-file-if-exists=.env scripts/check-all.ts",
    "check:okf": "node --env-file-if-exists=.env scripts/check-okf.ts",
    "check:links": "node --env-file-if-exists=.env scripts/check-links.ts",
    "check:collections": "node --env-file-if-exists=.env scripts/check-collections.ts",
    "check:schemas": "node scripts/check-schemas.ts",
    "gen:schemas": "node scripts/gen-schemas.ts",
    "migrate:index": "node --env-file-if-exists=.env scripts/migrate-index.ts",
    "fix:yaml-comments": "node --env-file-if-exists=.env scripts/fix-yaml-comments.ts",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:fast": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:all": "pnpm run test:fast && pnpm run check && pnpm run build && pnpm run test:prod && pnpm run test:e2e",
    "test:prod": "node tests/prod-smoke.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/node": "11.1.8",
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@monaco-editor/react": "4.7.0",
    "@nanostores/react": "2.0.1",
    "arktype": "2.2.8",
    "astro": "7.4.0",
    "cybercore-css": "0.3.0",
    "fuse.js": "7.5.0",
    "hack-font": "3.3.0",
    "monaco-editor": "0.57.0",
    "monaco-yaml": "5.5.1",
    "nanostores": "1.5.5",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.1.0-dev.20261016.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
